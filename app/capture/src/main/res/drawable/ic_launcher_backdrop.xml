<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background. The artwork's own dark plate is a diagonal gradient
  (#191A1F -> #090A0D, sampled from icon_512x512.png), so this repeats it across
  the full 108dp layer. The foreground badge only spans 92dp; matching the
  gradient here means the launcher mask cannot expose a seam at the corners.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#191A1F"
                    android:offset="0" />
                <item
                    android:color="#090A0D"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
