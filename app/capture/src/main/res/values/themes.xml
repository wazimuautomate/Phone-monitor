<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PhoneMonitor" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pm_green</item>
        <item name="colorOnPrimary">@color/pm_white</item>
        <item name="colorSecondary">@color/pm_green</item>
        <item name="android:windowBackground">@color/pm_bg</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/pm_bg</item>
        <item name="android:navigationBarColor">@color/pm_bg</item>
        <!-- Light theme: dark icons on the light status bar. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- Flat bottom-nav: no pill behind the selected icon, just green icon + label. -->
    <style name="Pm.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>
</resources>
