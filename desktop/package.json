{
  "name": "phone-monitor-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Remote desktop control of Android phones.",
  "author": "wazimuautomate",
  "main": "main.js",
  "scripts": {
    "prepare-assets": "node scripts/build.mjs",
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0"
  },
  "build": {
    "appId": "com.tricreta.phonemonitor.desktop",
    "productName": "Phone Monitor",
    "electronVersion": "33.4.11",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "PhoneMonitor-Setup-${version}.exe",
      "shortcutName": "Phone Monitor",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "PhoneMonitor-${version}-portable.exe"
    }
  }
}
